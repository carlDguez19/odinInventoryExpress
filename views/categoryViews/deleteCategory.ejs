<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Deletion</title>
</head>
<body>
    <h1>Delete Category</h1>

    <p>Are you sure you want to delete "<%= categoryData.name%>"?</p>
    
    <form action="/category/<%= categoryData.id %>/delete" method="POST">
        <button type="submit">Yes</button>
    </form>

    <a href="/category"><button>Cancel</button></a>
</body>
</html>