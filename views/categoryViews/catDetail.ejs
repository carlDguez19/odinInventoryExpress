<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <h1><%= category.name %></h1>
    <p><%= category.description %></p>

    <h2>Items in this Category</h2>
    <% if (items.length === 0) {%>
        <p>No items in this category</p>
    <% }else{ %>
        <ul>
            <% items.forEach(item => { %>
                <li>
                    <strong><%= item.name %></strong> - <%= item.description %>
                    (<%= item.price %> gold)

                    <a href="/item/<%= item.id%>">Detail</a>
                    <a href="/item/<%= item.id%>/update">Update</a>
                    <a href="/item/<%= item.id%>/delete">Delete</a>

                </li>
            <% }) %>
        </ul>
    <% } %>

    <a href="/category">
        Back to Categories
    </a>
</body>
</html>