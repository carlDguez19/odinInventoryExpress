<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/buttons.css">
    <link rel="stylesheet" href="/styles/lists.css">
</head>
<body>

    <div class="page">
        
        <h1>All Categories</h1>

        <a href="/category/create" class="btn lrg">Create New Category</a>

        <ul>
            <% categories.forEach(cat => { %>
                <li>

                    <div class="catName">
                        <strong><%= cat.name %></strong>
                    </div>

                    <div class="actions">
                        <a class="btn small" href="/category/<%= cat.id %>">Detail</a>
                        <a class="btn small" href="/category/<%= cat.id %>/update">Update</a>
                        <a class="btn small" href="/category/<%= cat.id %>/delete">Delete</a>
                    </div>

                </li>
            <% }) %>
        </ul>

        <a href="/item" class="btn small">Back to Items</a>
    
    </div>

</body>
</html>