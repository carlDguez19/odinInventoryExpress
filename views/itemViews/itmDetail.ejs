<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/buttons.css">
    <link rel="stylesheet" href="/styles/lists.css">
</head>
<body>

    <div class="page">
        
        <h1><%= itemDet.name %></h1>
        
        <p><%= itemDet.description %></p>

        <h2>Price: <%= itemDet.price %> gold</h2>
        
        <h3>Category ID: <%= itemDet.category_id%></h3>

        <a class="btn small" href="/item">Back to items</a>
        <a class="btn small" href="/category/<%= itemDet.category_id %>">View category</a>
    
    </div>

</body>
</html>