<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>All Items</h1>

    <a href="/item/create">Create New Item</a>

    <ul>
        <% items.forEach(itm => { %>
            <li>
                <strong><%= itm.name %></strong> - <%= itm.description %>
                (<%= itm.price %> gold)

                <a href="/item/<%=itm.id%>">Detail</a>
                <a href="/item/<%=itm.id%>/update">Update</a>
                <a href="/item/<%=itm.id%>/delete">Delete</a>

            </li>
        <% }) %>
    </ul>

    <a href="/category">Back to Categories</a>
</body>
</html>