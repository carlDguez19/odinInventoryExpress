<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/buttons.css">
    <link rel="stylesheet" href="/styles/lists.css">
</head>
<body>

    <div class="page">
        
        <h1>All Items</h1>

        <a href="/item/create" class="btn lrg">Create New Item</a>

        <ul>
            <% items.forEach(itm => { %>
                <li>
                    <div class="itmName">
                        <strong><%= itm.name %></strong>
                    </div>

                    <div class="price">
                        <%= itm.price %>g
                    </div>

                    <div class="actions">
                        <a class="btn small" href="/item/<%=itm.id%>">Detail</a>
                        <a class="btn small" href="/item/<%=itm.id%>/update">Update</a>
                        <a class="btn small" href="/item/<%=itm.id%>/delete">Delete</a>
                    </div>

                </li>
            <% }) %>
        </ul>

        <a href="/category" class="btn small">Back to Categories</a>

    </div>
    
</body>
</html>